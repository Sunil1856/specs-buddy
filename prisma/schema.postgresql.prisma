datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("ADMIN")
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
  campaigns    Campaign[]
  conversations Conversation[]
}

model Contact {
  id              String                @id @default(uuid())
  name            String
  phone           String                @unique
  email           String?
  city            String?
  countryCode     String                @default("IN")
  tags            String                @default("")
  optInStatus     String                @default("OPTED_IN")
  consentDate     DateTime?             @default(now())
  consentSource   String?               @default("MANUAL")
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  groupMembers    ContactGroupMember[]
  consentRecords  ConsentRecord[]
  optOutRecords   OptOutRecord[]
  campaignRecipients CampaignRecipient[]
  conversation    Conversation?

  @@index([phone])
  @@index([optInStatus])
}

model ContactGroup {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  members     ContactGroupMember[]
  campaigns   Campaign[]
}

model ContactGroupMember {
  id        String       @id @default(uuid())
  contactId String
  groupId   String
  joinedAt  DateTime     @default(now())
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([contactId, groupId])
  @@index([contactId])
  @@index([groupId])
}

model ConsentRecord {
  id           String    @id @default(uuid())
  contactId    String
  source       String
  optInDate    DateTime  @default(now())
  ipAddress    String?
  proofDetails String?
  createdAt    DateTime  @default(now())
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model OptOutRecord {
  id         String   @id @default(uuid())
  contactId  String
  phone      String
  reason     String?
  channel    String   @default("WHATSAPP")
  optOutDate DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([phone])
}

model MessageTemplate {
  id              String     @id @default(uuid())
  name            String     @unique
  metaTemplateId  String?
  category        String
  language        String     @default("en_US")
  status          String     @default("APPROVED")
  rejectionReason String?
  headerType      String     @default("NONE")
  headerContent   String?
  bodyText        String
  footerText      String?
  buttons         String?
  variableSample  String?
  lastSyncedAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  campaigns       Campaign[]

  @@index([status])
  @@index([category])
}

model Campaign {
  id               String              @id @default(uuid())
  name             String
  description      String?
  groupId          String?
  templateId       String?
  status           String              @default("DRAFT")
  scheduledAt      DateTime?
  timezone         String              @default("Asia/Kolkata")
  mediaHeaderUrl   String?
  variableMappings String?
  totalRecipients  Int                 @default(0)
  sentCount        Int                 @default(0)
  deliveredCount   Int                 @default(0)
  readCount        Int                 @default(0)
  failedCount      Int                 @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  group            ContactGroup?       @relation(fields: [groupId], references: [id])
  template         MessageTemplate?    @relation(fields: [templateId], references: [id])
  createdBy        User?               @relation(fields: [createdById], references: [id])
  recipients       CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
}

model CampaignRecipient {
  id            String    @id @default(uuid())
  campaignId    String
  contactId     String
  phone         String
  customerName  String
  status        String    @default("QUEUED")
  metaMessageId String?
  errorCode     String?
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  retryCount    Int       @default(0)

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
  @@index([metaMessageId])
  @@index([status])
}

model Message {
  id                  String   @id @default(uuid())
  metaMessageId       String?  @unique
  phone               String
  direction           String
  messageType         String   @default("TEMPLATE")
  content             String
  status              String   @default("SENT")
  campaignRecipientId String?
  conversationId      String?
  errorCode           String?
  errorMessage        String?
  timestamp           DateTime @default(now())

  @@index([phone])
  @@index([metaMessageId])
}

model Conversation {
  id                             String                @id @default(uuid())
  contactId                      String                @unique
  phone                          String
  contactName                    String
  lastMessage                    String?
  lastMessageAt                  DateTime              @default(now())
  unreadCount                    Int                   @default(0)
  assignedToId                   String?
  customerServiceWindowExpiresAt DateTime?
  status                         String                @default("OPEN")
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  contact                        Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo                     User?                 @relation(fields: [assignedToId], references: [id])
  messages                       ConversationMessage[]
  notes                          ConversationNote[]

  @@index([phone])
  @@index([lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  direction      String
  senderType     String       @default("CUSTOMER")
  body           String
  mediaUrl       String?
  mediaType      String?
  metaMessageId  String?
  status         String       @default("SENT")
  sentAt         DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([metaMessageId])
}

model ConversationNote {
  id             String       @id @default(uuid())
  conversationId String
  authorId       String?
  authorName     String       @default("Agent")
  content        String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model MediaFile {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  fileType     String
  mimeType     String
  fileSize     Int
  storageUrl   String
  metaMediaId  String?
  uploadedAt   DateTime @default(now())

  @@index([fileType])
}

model ApiCredential {
  id                 String    @id @default(uuid())
  provider           String    @default("META_WHATSAPP")
  gatewayMode        String    @default("META_CLOUD_API") // META_CLOUD_API or WHATSAPP_WEB
  appId              String?
  wabaId             String?
  phoneNumberId      String?
  accessToken        String?
  webhookVerifyToken String?
  appSecret          String?
  isTestMode         Boolean   @default(true)
  qualityRating      String    @default("GREEN")
  messagingLimit     String    @default("TIER_1_1K")
  status             String    @default("CONNECTED")
  lastTestedAt       DateTime?

  // WhatsApp Web Session Fields
  webSessionStatus   String    @default("DISCONNECTED") // DISCONNECTED, QR_READY, PAIRING, CONNECTED
  webSessionQrCode   String?
  webConnectedPhone  String?
  webPushName        String?
  webBattery         Int?      @default(92)
  webPlatform        String?   @default("WhatsApp Web (Multi-Device)")
  webLastActive      DateTime?

  updatedAt          DateTime  @default(now()) @updatedAt
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventType   String
  metaId      String?
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventType])
  @@index([processed])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action])
}
