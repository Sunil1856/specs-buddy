# SPECS BUDDY WhatsApp Marketing Suite - Environment Variables Template
# Copy this file to .env and fill in your values

# App Config
NEXT_PUBLIC_APP_NAME="SPECS BUDDY WhatsApp Marketing Suite"
NEXT_PUBLIC_BRAND_NAME="SPECS BUDDY"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"

# Database
# For SQLite (default development):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production Docker / Supabase / RDS):
# DATABASE_URL="postgresql://specsbuddy_user:specsbuddy_password@postgres:5432/specsbuddy_db?schema=public"

# Authentication & Security
JWT_SECRET="generate_a_random_32_byte_secret_key_here"
SESSION_MAX_AGE_DAYS=7

# Initial Super Admin Credentials
ADMIN_INITIAL_EMAIL="admin@specsbuddy.com"
ADMIN_INITIAL_PASSWORD="ChangeThisPassword123!"

# Meta WhatsApp Cloud API Credentials
META_APP_ID="123456789012345"
META_WABA_ID="123456789012345"
META_PHONE_NUMBER_ID="123456789012345"
META_ACCESS_TOKEN="EAAxxxxxxx..."
META_APP_SECRET="abcdef1234567890..."
META_WEBHOOK_VERIFY_TOKEN="specs_buddy_secure_verify_token_2026"
META_GRAPH_API_VERSION="v20.0"

# Simulation / Test Mode Toggle (true for offline sandbox testing, false for real live WhatsApp delivery)
META_TEST_MODE="true"

# Redis
REDIS_URL="redis://localhost:6379"

# Storage
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"
